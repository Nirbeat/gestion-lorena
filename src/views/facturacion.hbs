<section class="page-header">
  <h1>Facturación</h1>
  <p class="subtitle">Registre una nueva cuota de seguro</p>
</section>
<div class="search-card">
  <form class="search-form" action="/facturacion" method="GET">
    <div class="form-group" style="gap: 0.65rem;">
      <label for="buscarDominio" style="font-weight: 700;">Buscar asegurado por Dominio</label>
      <div class="search-input-group">
        <input type="text" id="buscarDominio" name="buscarDominio" placeholder="Ej: AB123CD" required
          style="text-transform: uppercase;" />
        <button type="submit" class="btn btn-primary btn-search">Buscar</button>
      </div>
    </div>
  </form>
  <p id="search-error" class="search-error-message" style="display: none;"></p>
</div>

<form action="/api/facturas" method="POST" class="form-card">
  <div class="form-grid">
    <div class="form-group">
      <label for="cuota">Cuota N°</label>
      <input type="text" name="cuota" min="1" placeholder="Número de cuota" value="{{calcularCuota asegurado.cuota}}"
        required />
    </div>

    <div class="form-group">
      <label for="compañia">Compañía</label>
      <input type="text" name="compania" placeholder="Ej: Sancor Seguros" value="{{asegurado.compania}}" required />
    </div>

    <div class="form-group">
      <label for="asegurado">Asegurado</label>
      <input type="text" name="asegurado" placeholder="Nombre y apellido" value="{{asegurado.asegurado}}" required />
    </div>

    <div class="form-group">
      <label for="matricula">N° Póliza</label>
      <input type="text" name="nroPoliza" placeholder="Ej: 0123456" value="{{asegurado.nroPoliza}}" required />
    </div>

    <div class="form-group">
      <label for="tipoDeVehiculo">Tipo de vehículo</label>
      <select name="tipoDeVehiculo">
        <option value="---" {{definirTipoVehiculo asegurado.tipoDeVehiculo "---" }}>No aplica</option>
        <option value="auto" {{definirTipoVehiculo asegurado.tipoDeVehiculo "auto" "selected" }}>Auto</option>
        <option value="moto" {{definirTipoVehiculo asegurado.tipoDeVehiculo "moto" "selected" }}>Moto</option>
      </select>
    </div>

    <div class="form-group">
      <label for="vehiculo">Marca</label>
      <input type="text" name="vehiculo" placeholder="Ej: Ford Fiesta" value="{{asegurado.vehiculo}}" />
    </div>


    <div class="form-group">
      <label for="dominio">Dominio</label>
      <input type="text" name="dominio" placeholder="Ej: AB123CD" value="{{asegurado.dominio}}" />
    </div>


    <div class="form-group">
      <label for="precio">Cobertura</label>
      <input type="text" name="cobertura" placeholder="Ej: R.C." required value="{{asegurado.cobertura}}" />
    </div>

    <div class="form-group">
      <label for="precio">Otros</label>
      <input type="text" name="otros" placeholder="Ej: Uso particular" value="{{asegurado.otros}}" />
    </div>

    <div class="form-group">
      <label for="precio">Importe ($)</label>
      <input type="number" name="importe" placeholder="0.00" required value="{{asegurado.importe}}" />
    </div>

    <div class="form-group">
      <label for="proxVencimiento">Próximo vencimiento</label>
      <input type="date" name="proxVencimiento" value="{{definirFecha asegurado.proxVencimiento}}" required />
    </div>

  </div>

  <div class="form-checkbox">
    <div class="checkbox-left">
      <input type="checkbox" id="esTransferencia" name="esTransferencia" value="true" />
      <label for="esTransferencia">Es transferencia (aplica recargo)</label>
    </div>
    <div class="recargo-wrapper" id="recargo-wrapper">
      <label for="recargo">Recargo ($)</label>
      <input type="number" id="recargo" name="recargo" step="0.01" min="0" placeholder="0.00"
        value="{{asegurado.recargo}}" />
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Generar Factura</button>
    <button type="reset" class="btn btn-secondary">Limpiar</button>
  </div>
</form>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const selectVehiculo = document.querySelector('select[name="tipoDeVehiculo"]');
    const vehiculoInput = document.querySelector('input[name="vehiculo"]');
    const dominioInput = document.querySelector('input[name="dominio"]');
    const otrosInput = document.querySelector('input[name="otros"]');

    const checkboxTransferencia = document.getElementById('esTransferencia');
    const recargoInput = document.getElementById('recargo');
    const form = document.querySelector('.form-card');

    const searchError = document.getElementById('search-error');

    function toggleVehicleFields() {
      const isNoAplica = selectVehiculo.value === '---';
      vehiculoInput.disabled = isNoAplica;
      dominioInput.disabled = isNoAplica;
      otrosInput.disabled = isNoAplica;

      if (isNoAplica) {
        vehiculoInput.value = '';
        dominioInput.value = '';
        otrosInput.value = '';
      }
    }

    function toggleRecargo() {
      const isChecked = checkboxTransferencia.checked;
      recargoInput.disabled = !isChecked;
    }

    selectVehiculo.addEventListener('change', toggleVehicleFields);
    checkboxTransferencia.addEventListener('change', toggleRecargo);

    form.addEventListener('reset', () => {
      setTimeout(() => {
        toggleVehicleFields();
        toggleRecargo();
        searchError.style.display = 'none';
        searchError.textContent = '';
      }, 0);
    });

    // Initialize state on load
    toggleVehicleFields();
    toggleRecargo();
  });
</script>