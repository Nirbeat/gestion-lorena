<div id="api-feedback" class="empty-state"
    style="display: none; margin-top: 1.5rem; border-left: 4px solid var(--accent); text-align: left; padding: 1.5rem; max-width: 100%;">
    <h3 style="color: var(--primary); margin-bottom: 0.5rem; font-size: 1.15rem; font-weight: 700;">Simulación de Envío
        de Datos</h3>
    <p style="margin-bottom: 0.5rem; font-size: 0.95rem;">Se envió una solicitud <code>POST</code> al endpoint
        <strong><span id="feedback-url"></span></strong> con los siguientes datos:</p>
    <pre id="feedback-data"
        style="background: #fafafa; padding: 1rem; border-radius: 6px; border: 1px solid var(--border); font-family: monospace; font-size: 0.85rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all;"></pre>
</div>
{{else}}
{{#unless error}}
<div class="empty-state">
    <p>Utilice la barra superior para buscar un asegurado por su dominio / patente.</p>
</div>
{{/unless}}
{{/if}}

<style>
    .input-editable-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .input-editable-wrapper input {
        width: 100%;
        padding-right: 2.5rem !important;
    }

    .input-editable-wrapper input[readonly] {
        background-color: #f3f4f6;
        color: #4b5563;
        border-color: #e5e7eb;
        cursor: not-allowed;
    }

    .btn-edit {
        position: absolute;
        right: 8px;
        background: none;
        border: none;
        color: var(--primary-light);
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s, transform 0.15s;
        border-radius: 4px;
    }

    .btn-edit:hover {
        color: var(--accent);
        transform: scale(1.15);
    }

    .btn-edit.edit-active {
        color: var(--success) !important;
    }
</style>

<script>
    function habilitarCampo(inputId, btnId) {
        const input = document.getElementById(inputId);
        const btn = document.getElementById(btnId);

        if (input.hasAttribute('readonly')) {
            input.removeAttribute('readonly');
            input.focus();
            btn.classList.add('edit-active');

            // If it's a text input, move cursor to the end
            if (input.type === 'text') {
                const val = input.value;
                input.value = '';
                input.value = val;
            }
        } else {
            input.setAttribute('readonly', 'readonly');
            btn.classList.remove('edit-active');
        }
    }

    // Interceptamos la submission para simular y ejecutar la peticion
    const form = document.getElementById('form-asegurado');
    if (form) {
        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(form);
            const data = {};
            formData.forEach((value, key) => {
                data[key] = value;
            });

            const actionUrl = form.getAttribute('action');

            // Mostrar feedback en pantalla
            const feedbackDiv = document.getElementById('api-feedback');
            const feedbackUrl = document.getElementById('feedback-url');
            const feedbackData = document.getElementById('feedback-data');

            feedbackUrl.textContent = actionUrl;
            feedbackData.textContent = JSON.stringify(data, null, 2);
            feedbackDiv.style.display = 'block';
            feedbackDiv.scrollIntoView({ behavior: 'smooth' });

            // Realizar la petición fetch al endpoint (el cual fallará o devolverá 404 porque no está implementado en el backend)
            try {
                const response = await fetch(actionUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                console.log('Respuesta del servidor:', response.status);
            } catch (err) {
                console.warn('Error en la petición (esperado si no está implementada la ruta):', err);
            }
        });
    }
</script> --}}