{{!-- <section class="page-header">
    <h1>Gestión de Asegurados</h1>
    <p class="subtitle">Busque un asegurado por dominio para visualizar y editar sus datos</p>
</section>

<!-- Barra de Búsqueda -->
<div class="filter-bar">
    <form action="/asegurados" method="GET" class="filter-form"
        style="width: 100%; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <label for="search_dominio" style="font-weight: 600; color: var(--primary);">Buscar Dominio:</label>
            <input type="text" id="search_dominio" name="dominio" value="{{dominio}}" placeholder="Ej: AB123CD" required
                style="padding: 0.5rem 0.75rem; border: 1.5px solid var(--border); border-radius: 6px; font-size: 0.95rem; text-transform: uppercase;" />
            <button type="submit" class="btn btn-primary btn-sm">Buscar</button>
        </div>
        {{#if asegurado}}
        <div>
            <span class="badge badge-auto"
                style="padding: 0.5rem 1rem; font-size: 0.85rem; background: #e0f2fe; color: #0369a1;">Asegurado:
                {{asegurado.nombre}}</span>
        </div>
        {{/if}}
    </form>
</div>

{{#if error}}
<div class="empty-state"
    style="border-left: 4px solid var(--danger); margin-bottom: 2rem; text-align: left; padding: 1.5rem 2rem;">
    <p
        style="color: var(--danger); font-weight: 600; font-size: 1.05rem; display: flex; align-items: center; gap: 0.5rem;">
        <span>⚠️</span> {{error}}
    </p>
</div>
{{/if}}

{{#if asegurado}}
