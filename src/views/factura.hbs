<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Imprimir Recibo - Las Margaritas</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        @page {
            size: A4;
            margin: 10mm 12mm;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #2d3748;
            background-color: #ffffff;
            padding: 0;
        }

        .print-area {
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
            display: table;
            border-collapse: collapse;
        }

        .print-row {
            display: table-row;
        }

        .print-cell {
            display: table-cell;
            width: 50%;
            vertical-align: top;
            padding: 0 8px;
        }

        .b-right {
            border-right: 1px dashed #cbd5e0;
        }

        .recibo-box {
            border: 1px solid #4a5568;
            border-radius: 6px;
            padding: 8px 10px;
            background-color: #ffffff;
            font-size: 8.8pt;
            line-height: 1.4;
        }

        .tipo-recibo {
            text-align: right;
            font-size: 8pt;
            font-weight: bold;
            color: #718096;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5px;
            background-color: #4a5568;
            color: #ffffff;
            border-radius: 4px;
            overflow: hidden;
        }

        .header-left {
            width: 38%;
            padding: 6px;
            font-size: 8pt;
            border-right: 1px solid #718096;
            vertical-align: middle;
        }

        .header-left .brand-icons {
            font-size: 13pt;
            margin-bottom: 2px;
        }

        .header-right {
            width: 62%;
            padding: 6px;
            text-align: center;
            vertical-align: middle;
        }

        .header-right h1 {
            font-size: 10.5pt;
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 4px;
            letter-spacing: 0.3px;
        }

        .header-right .meta-info {
            font-size: 8.5pt;
            color: #edf2f7;
        }

        .data-row-block {
            background-color: #edf2f7;
            border: 1px solid #cbd5e0;
            padding: 6px 10px;
            font-weight: bold;
            font-size: 9.5pt;
            margin-bottom: 4px;
            border-radius: 4px;
            display: flex;
            align-items: center;
        }

        .data-row-block span {
            color: #4a5568;
            margin-right: 6px;
        }

        .data-row-block .value-slot {
            color: #1a202c;
            font-weight: bold;
            flex-grow: 1;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 6px;
        }

        .details-table th,
        .details-table td {
            border: 1px solid #cbd5e0;
            padding: 4px 7px;
            text-align: left;
        }

        .details-table th {
            background-color: #f7fafc;
            color: #4a5568;
            width: 32%;
            font-weight: bold;
            font-size: 8.5pt;
        }

        .details-table td {
            background-color: #ffffff;
            font-weight: 500;
        }

        .check-item {
            display: inline-block;
            margin-right: 15px;
        }

        /* Reemplazar la clase .square y .square.checked por estas: */
        .square {
            display: inline-block;
            width: 12px;
            height: 12px;
            border: 1px solid #4a5568;
            margin-right: 4px;
            vertical-align: middle;
            background-color: #ffffff;
            text-align: center;
            line-height: 10px;
            font-size: 9pt;
            font-weight: bold;
            color: #2b6cb0;
        }

        .footer-table {
            width: 100%;
            border-collapse: collapse;
        }

        .footer-cell {
            border: 1px solid #4a5568;
            padding: 6px;
            background-color: #ffffff;
            vertical-align: middle;
        }

        .footer-left {
            width: 55%;
        }

        .footer-right {
            width: 45%;
            background-color: #edf2f7;
            text-align: right;
        }

        .amount-box {
            display: inline-block;
        }

        .amount-box .lbl {
            font-size: 11pt;
            font-weight: bold;
        }

        .amount-box .val {
            font-size: 13pt;
            font-weight: bold;
            color: #2b6cb0;
        }

        .vencimiento-txt {
            font-size: 8.5pt;
            font-weight: bold;
            color: #2d3748;
            margin-bottom: 3px;
        }

        .recargo-txt {
            font-size: 7.5pt;
            color: #c53030;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .legal-txt {
            font-size: 7pt;
            color: #718096;
            line-height: 1.2;
        }
    </style>
</head>

<body>

    <div class="print-area">
        <div class="print-row">

            <div class="print-cell b-right">
                <div class="tipo-recibo">Original</div>
                {{>comprobante}}
            </div>

            <div class="print-cell">
                <div class="tipo-recibo">Duplicado</div>
                {{>comprobante}}
            </div>

        </div>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', () => {
            // Llama nativamente a la ventana de impresión del navegador
            window.print();

            // Opcional: Cuando termine de imprimir (o cancele), vuelve automáticamente a la pantalla de facturación
            window.onafterprint = function () {
                window.location.href = '/facturacion';
            };
        });
    </script>
</body>

</html>